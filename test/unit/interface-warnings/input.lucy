machine kid {
  guard ok = :ok

  initial state waiting {
    go => ok => action(:log) => waiting
    delay(:wait) => waiting
  }
}

machine timer {
  initial state running {
    delay(1s) => action(:ring) => over
  }

  final state over {}
}

machine plain {
  initial state only {
    ping => only
  }
}

machine parent {
  initial state idle {
    @entry => assign(child, spawn(kid)) => assign(other, spawn(plain))
    again => assign(child, spawn(kid)) => idle
    wait => waiting
  }

  state waiting {
    invoke(timer) {
      done => idle
    }
  }
}

machine reporter {
  initial state only {
    go => send(parent, report) => send(parent, unknown) => only
  }
}

machine boss {
  event start
  event report

  initial state idle {
    start => assign(worker, spawn(reporter)) => idle
    report => idle
  }
}

machine card {
  input title(string)
  input owner

  initial state shown {}
}

machine free {
  initial state only {}
}

machine board {
  initial state idle {
    full => assign(a, spawn(card) {
      title = event.data
      owner = self
    }) => idle
    short => assign(b, spawn(card) { title = event.data }) => idle
    none => assign(c, spawn(card)) => idle
    extra => assign(d, spawn(card) {
      title = event.data
      owner = self
      colour = event.data
    }) => idle
    unchecked => assign(e, spawn(free) { anything = self }) => idle
    wait => waiting
  }

  state waiting {
    invoke(card) {
      done => idle
    }
  }
}
