machine kid {
  event ping(number)
  event unused

  initial state only {
    ping => only
    pong => only
  }
}

machine parent {
  action spawnKid = assign(child, spawn(kid))
  action store = assign(last)

  event go(number)
  event stop

  initial state idle {
    @entry => spawnKid
    go => send(child, ping) => send(child, nope) => idle
    stop => store => idle
  }
}

machine quiet {
  event ping
  event set(number)

  initial state only {
    ping => only
    set => only
  }
}

machine teller {
  initial state idle {
    @entry => assign(kid, spawn(quiet))
    one => send(kid, ping, self) => idle
    two => send(kid, set, context.n) => idle
    three => send(kid, ping) => idle
  }
}

machine keeper {
  initial state idle {
    add => append(many, spawn(quiet)) => idle
    tell => send(many, ping) => idle
    both => append(mixed, spawn(quiet)) => idle
    one => assign(mixed, spawn(quiet)) => idle
    poke => send(mixed, ping) => idle
  }
}
