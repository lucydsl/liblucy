#!/bin/bash

LUCYC="${LUCYC:-bin/lucyc}"
ret=0
COLORDIFF=colordiff
command -v colordiff &> /dev/null || COLORDIFF=cat
upd=0

red='\033[0;31m'
nc='\033[0m' # No Color

usage() {
  program_name=$(basename $0)
  bold=$(tput bold)
  normal=$(tput sgr0)

  cat <<EOM
Usage: $program_name [options] path/to/test/folder/

Run snapshot tests.

Options:

  -u        Updates the snapshots.
  -h        Display this help message
EOM
  exit 0
}

run_test() {
  local d=$1
  local skip="${d}.skip"

  if [ -f $skip ]; then
    return 0
  fi

  local input="${d}input.lucy"
  local tmp=$(mktemp)
  local dtsflag=""

  if [[ "$input" == *"error_"* ]]; then
    local output="${d}expected.error"
  elif [[ "$input" == *"dts_"* ]]; then
    local output="${d}expected.d.ts"
    local dtsflag="--print dts"
  elif [[ "$input" == *"/ts_"* ]]; then
    local output="${d}expected.ts"
    local dtsflag="--ts"
  else
    local output="${d}expected.js"
  fi

  # A test whose name has ssr_ in it compiles for a server.
  local targetflag=""
  if [[ "$input" == *"ssr_"* ]]; then
    targetflag="--target ssr"
  fi
  # And one with hydrate_ in it, for hydration.
  if [[ "$input" == *"hydrate_"* ]]; then
    targetflag="$targetflag --hydrate"
  fi

  $LUCYC $dtsflag $targetflag $input >> $tmp 2>&1

  if [ "$upd" -eq 1 ]; then
    mv $tmp $output
    return
  fi

  if [ ! -f $output ]; then
      mv $tmp $output
      return
  fi
  
  d=$(diff $output $tmp | $COLORDIFF)

  if [ ${#d} -ge 1 ]; then
    echo -e "${red}FAILED${nc} - $input"
    echo ""
    echo "$d"

    ret=1
  fi
}

while getopts "hu" opt; do
  case ${opt} in
    h )
      usage;
      ;;
    u )
      upd=1
      ;;
  esac
done
shift $((OPTIND -1))

folder=$@

if [ -z "$folder" ]; then
  for d in test/snapshots/*/ ; do
    run_test $d
  done
else
  run_test $folder
fi

exit $ret